generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Portal {
  RECRUITER
  EMPLOYEE
  TRAINING
  MANAGEMENT
  ADMIN
}

enum MRFStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  CANCELLED
  CLOSED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CandidateStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  SELECTED
  REJECTED
  HOLD
  TRAINING_PENDING
  TRAINING_IN_PROGRESS
  TRAINING_COMPLETED
  EXAM_PENDING
  EXAM_PASSED
  FAILED
  OFFER_GENERATED
  OFFER_ACCEPTED
  OFFER_REJECTED
  FINAL_APPROVED
  ONBOARDED
}

enum DocumentType {
  RESUME
  ID_PROOF
  CERTIFICATE
  EDUCATION
  OFFER_LETTER
  APPOINTMENT_LETTER
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum InterviewStatus {
  SCHEDULED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum Recommendation {
  STRONG_HIRE
  HIRE
  HOLD
  NO_HIRE
}

enum AssessmentType {
  PSYCHOMETRIC
  TECHNICAL
  COMPETENCY
}

enum TrainingEnrollmentStatus {
  PENDING
  ENROLLED
  IN_PROGRESS
  COMPLETED
  INCOMPLETE
  DROPPED
}

enum ExamAttemptStatus {
  LINK_SENT
  STARTED
  COMPLETED
  EXPIRED
  PASSED
  FAILED
}

enum LetterStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  RELEASED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

enum ProbationStatus {
  ACTIVE
  REVIEW_PENDING
  EXTENDED
  CONFIRMED
  REJECTED
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String
  phone          String?
  roleId         String
  role           Role      @relation(fields: [roleId], references: [id])
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  activePortal   Portal
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  createdMRFs          MRFRequest[]       @relation("MRFCreatedBy")
  managesMRFs          MRFRequest[]       @relation("MRFReportingManager")
  mrfApprovals         MRFApproval[]
  createdCandidates    Candidate[]        @relation("CandidateCreatedBy")
  assignedCandidates   Candidate[]        @relation("CandidateRecruiter")
  candidateComments    CandidateComment[]
  scheduledInterviews  Interview[]        @relation("InterviewScheduledBy")
  interviewPanels      InterviewPanel[]
  interviewFeedback    InterviewFeedback[]
  createdTraining      TrainingBatch[]
  offerApprovals       OfferApproval[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  reports              Report[]

  @@index([roleId])
  @@index([departmentId])
  @@index([isActive])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  portal      Portal
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  roles       RolePermission[]
  createdAt   DateTime @default(now())
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  location    String?
  country     String?
  users       User[]
  mrfRequests MRFRequest[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model MRFRequest {
  id                 String    @id @default(cuid())
  requestNo          String    @unique
  departmentId       String
  department         Department @relation(fields: [departmentId], references: [id])
  designation        String
  roleSummary        String?
  vacancies          Int
  requiredExperience Decimal   @db.Decimal(5, 2)
  skillsRequired     String[]
  budgetMin          Decimal   @db.Decimal(12, 2)
  budgetMax          Decimal   @db.Decimal(12, 2)
  reportingManagerId String
  reportingManager   User      @relation("MRFReportingManager", fields: [reportingManagerId], references: [id])
  location           String
  country            String?
  status             MRFStatus @default(DRAFT)
  rejectionReason    String?
  createdById        String
  createdBy          User      @relation("MRFCreatedBy", fields: [createdById], references: [id])
  submittedAt        DateTime?
  approvedAt         DateTime?
  closedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  approvals MRFApproval[]
  candidates Candidate[]

  @@index([departmentId])
  @@index([status])
  @@index([designation])
  @@index([createdById])
  @@index([reportingManagerId])
}

model MRFApproval {
  id          String         @id @default(cuid())
  mrfId       String
  mrf         MRFRequest     @relation(fields: [mrfId], references: [id], onDelete: Cascade)
  approverId  String
  approver    User           @relation(fields: [approverId], references: [id])
  level       Int
  status      ApprovalStatus @default(PENDING)
  remarks     String?
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([mrfId, level])
  @@index([approverId, status])
}

model Candidate {
  id                   String          @id @default(cuid())
  candidateNo          String          @unique
  mrfId                String?
  mrf                  MRFRequest?     @relation(fields: [mrfId], references: [id])
  name                 String
  email                String          @unique
  phone                String          @unique
  alternatePhone       String?
  designation          String?
  experienceYears      Decimal         @default(0) @db.Decimal(5, 2)
  skills               String[]
  education            Json?
  certifications       String[]
  currentCtc           Decimal?        @db.Decimal(12, 2)
  expectedCtc          Decimal?        @db.Decimal(12, 2)
  noticePeriodDays     Int?
  location             String?
  source               String?
  status               CandidateStatus @default(APPLIED)
  duplicateWarningSeen Boolean         @default(false)
  lockedByUserId       String?
  lockedAt             DateTime?
  createdById          String
  createdBy            User            @relation("CandidateCreatedBy", fields: [createdById], references: [id])
  assignedRecruiterId  String?
  assignedRecruiter    User?           @relation("CandidateRecruiter", fields: [assignedRecruiterId], references: [id])
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?

  documents          CandidateDocument[]
  comments           CandidateComment[]
  statusHistory      CandidateStatusHistory[]
  interviews         Interview[]
  assessments        Assessment[]
  trainingEnrollments TrainingEnrollment[]
  examAttempts       ExamAttempt[]
  offerLetters       OfferLetter[]
  appointmentLetters AppointmentLetter[]
  probationReviews   ProbationReview[]

  @@index([mrfId])
  @@index([status])
  @@index([designation])
  @@index([assignedRecruiterId])
  @@index([deletedAt])
}

model CandidateStatusHistory {
  id             String          @id @default(cuid())
  candidateId    String
  candidate      Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  previousStatus CandidateStatus?
  nextStatus     CandidateStatus
  reason         String?
  changedById    String?
  changedAt      DateTime        @default(now())

  @@index([candidateId, changedAt])
  @@index([nextStatus])
}

model CandidateDocument {
  id                 String             @id @default(cuid())
  candidateId        String
  candidate          Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  type               DocumentType
  fileName           String
  filePath           String
  mimeType           String
  sizeBytes          Int
  version            Int                @default(1)
  verificationStatus VerificationStatus @default(PENDING)
  verificationRemarks String?
  uploadedById       String?
  verifiedById       String?
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  @@index([candidateId, type])
  @@index([verificationStatus])
}

model CandidateComment {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  body        String
  isInternal  Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([candidateId, createdAt])
  @@index([authorId])
}

model Interview {
  id            String          @id @default(cuid())
  candidateId   String
  candidate     Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  roundName     String
  scheduledAt   DateTime
  durationMins  Int             @default(45)
  mode          String
  location      String?
  meetingUrl    String?
  status        InterviewStatus @default(SCHEDULED)
  scheduledById String
  scheduledBy   User            @relation("InterviewScheduledBy", fields: [scheduledById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  panel    InterviewPanel[]
  feedback InterviewFeedback[]

  @@index([candidateId])
  @@index([scheduledAt])
  @@index([status])
}

model InterviewPanel {
  interviewId String
  userId      String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@id([interviewId, userId])
}

model InterviewFeedback {
  id             String         @id @default(cuid())
  interviewId    String
  interview      Interview      @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewerId  String
  interviewer    User           @relation(fields: [interviewerId], references: [id])
  competencyJson Json
  score          Decimal        @db.Decimal(5, 2)
  recommendation Recommendation
  remarks        String
  submittedAt    DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([interviewId, interviewerId])
  @@index([recommendation])
}

model Assessment {
  id          String         @id @default(cuid())
  candidateId String
  candidate   Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  type        AssessmentType
  criteria    Json
  score       Decimal?       @db.Decimal(5, 2)
  result      String?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@index([candidateId, type])
}

model TrainingBatch {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  topic       String
  trainerName String?
  startsAt    DateTime
  endsAt      DateTime
  location    String?
  capacity    Int
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  enrollments TrainingEnrollment[]
  attendance  TrainingAttendance[]

  @@index([startsAt, endsAt])
}

model TrainingEnrollment {
  id          String                   @id @default(cuid())
  candidateId String
  candidate   Candidate                @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  batchId     String
  batch       TrainingBatch            @relation(fields: [batchId], references: [id])
  status      TrainingEnrollmentStatus @default(PENDING)
  remarks     String?
  completedAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  attendance TrainingAttendance[]

  @@unique([candidateId, batchId])
  @@index([status])
}

model TrainingAttendance {
  id           String             @id @default(cuid())
  enrollmentId String
  enrollment   TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  batchId      String
  batch        TrainingBatch      @relation(fields: [batchId], references: [id])
  sessionDate  DateTime
  present      Boolean
  remarks      String?
  markedById   String?
  createdAt    DateTime           @default(now())

  @@unique([enrollmentId, sessionDate])
  @@index([batchId, sessionDate])
}

model Exam {
  id              String   @id @default(cuid())
  name            String
  designation     String?
  passingMarks    Decimal  @db.Decimal(5, 2)
  maxAttempts     Int      @default(2)
  linkValidityMins Int     @default(1440)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  attempts ExamAttempt[]

  @@index([designation])
  @@index([active])
}

model ExamAttempt {
  id           String            @id @default(cuid())
  candidateId  String
  candidate    Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  examId       String
  exam         Exam              @relation(fields: [examId], references: [id])
  attemptNo    Int
  tokenHash    String
  linkExpiresAt DateTime
  startedAt    DateTime?
  completedAt  DateTime?
  score        Decimal?          @db.Decimal(5, 2)
  status       ExamAttemptStatus @default(LINK_SENT)
  resultJson   Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([candidateId, examId, attemptNo])
  @@index([candidateId, status])
  @@index([linkExpiresAt])
}

model SalaryTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  designation String?
  structure   Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OfferLetter {
  id             String       @id @default(cuid())
  candidateId    String
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  offerNo        String       @unique
  salaryTemplateId String?
  ctcAmount      Decimal      @db.Decimal(12, 2)
  salaryBreakup  Json
  expiryDate     DateTime
  status         LetterStatus @default(DRAFT)
  pdfPath        String?
  releasedAt     DateTime?
  acceptedAt     DateTime?
  rejectedAt     DateTime?
  rejectionReason String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  approvals OfferApproval[]

  @@index([candidateId])
  @@index([status])
  @@index([expiryDate])
}

model OfferApproval {
  id          String         @id @default(cuid())
  offerId     String
  offer       OfferLetter    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  approverId  String
  approver    User           @relation(fields: [approverId], references: [id])
  level       Int
  status      ApprovalStatus @default(PENDING)
  remarks     String?
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([offerId, level])
  @@index([approverId, status])
}

model AppointmentLetter {
  id          String       @id @default(cuid())
  candidateId String
  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  letterNo    String       @unique
  joiningDate DateTime
  status      LetterStatus @default(DRAFT)
  pdfPath     String?
  releasedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([candidateId])
  @@index([joiningDate])
  @@index([status])
}

model ProbationReview {
  id              String          @id @default(cuid())
  candidateId      String
  candidate        Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  managerId        String
  startsAt         DateTime
  endsAt           DateTime
  status           ProbationStatus @default(ACTIVE)
  recommendation   String?
  managerRemarks   String?
  extensionDays    Int?
  decidedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([candidateId])
  @@index([status])
  @@index([endsAt])
}

model Notification {
  id          String             @id @default(cuid())
  userId      String?
  user        User?              @relation(fields: [userId], references: [id])
  candidateId String?
  channel     String
  subject     String
  body        String
  status      NotificationStatus @default(QUEUED)
  retryCount  Int                @default(0)
  sentAt      DateTime?
  readAt      DateTime?
  error       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId, status])
  @@index([candidateId])
  @@index([createdAt])
}

model Report {
  id          String   @id @default(cuid())
  name        String
  type        String
  filters     Json?
  filePath    String?
  generatedById String
  generatedBy User     @relation(fields: [generatedById], references: [id])
  generatedAt DateTime @default(now())
  expiresAt   DateTime?

  @@index([type])
  @@index([generatedById, generatedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id])
  entityType  String
  entityId    String
  action      String
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
