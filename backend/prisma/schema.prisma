datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  password     String
  firstName    String
  lastName     String
  role         String    @default("RECRUITER")
  departmentId String?
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  department              Department?           @relation(fields: [departmentId], references: [id])
  mrfCreated              MRF[]                 @relation("MRFCreator")
  mrfApproved             MRF[]                 @relation("MRFApprover")
  candidatesAdded         Candidate[]           @relation("CandidateAdder")
  interviewsScheduled     Interview[]           @relation("InterviewScheduler")
  interviewFeedback       InterviewFeedback[]
  trainingBatchesManaged  TrainingBatch[]       @relation("BatchManager")
  notifications           Notification[]
  auditLogs               AuditLog[]
  candidateComments       CandidateComment[]
  agencyPartner           AgencyPartner?
  communicationsSent      Communication[]       @relation("CommSender")
  casualWorkersAdded      CasualWorker[]        @relation("CasualWorkerAdder")
  incomingMailsProcessed  IncomingMail[]        @relation("MailProcessor")
  outreachSent            MrfOutreach[]
  jobPostings             JobPosting[]
}

model Department {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users User[]
  mrfs  MRF[]
}

model MRF {
  id               String    @id @default(cuid())
  mrfNumber        String    @unique
  departmentId     String
  designation      String
  vacancies        Int
  experience       String
  skills           String    @default("[]")
  salaryMin        Float?
  salaryMax        Float?
  location         String?
  branch           String?
  country          String    @default("India")
  reportingManager String?
  status           String    @default("DRAFT")
  priority         String    @default("NORMAL")
  workerType       String    @default("PERMANENT")
  description      String?
  createdById      String
  approvedById     String?
  approvedAt       DateTime?
  rejectionReason  String?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  department        Department        @relation(fields: [departmentId], references: [id])
  createdBy         User              @relation("MRFCreator", fields: [createdById], references: [id])
  approvedBy        User?             @relation("MRFApprover", fields: [approvedById], references: [id])
  candidates        Candidate[]
  jobDescription    JobDescription?
  pipelineStages    PipelineStage[]
  agencySubmissions AgencySubmission[]
  outreach          MrfOutreach[]
  incomingMails     IncomingMail[]    @relation("MRFIncomingMails")
  jobPostings       JobPosting[]
}

model Candidate {
  id              String    @id @default(cuid())
  candidateId     String    @unique
  firstName       String
  lastName        String
  email           String    @unique
  phone           String
  alternatePhone  String?
  dateOfBirth     DateTime?
  gender          String?
  address         String?
  city            String?
  state           String?
  country         String?
  pincode         String?
  designation     String
  experience      Int       @default(0)
  currentSalary   Float?
  expectedSalary  Float?
  noticePeriod    Int?
  skills          String    @default("[]")
  education       String    @default("[]")
  certifications  String    @default("[]")
  currentCompany  String?
  resumePath      String?
  status          String    @default("APPLIED")
  source          String?
  sourceDetail    String?
  mrfId           String?
  locationId      String?
  addedById       String
  sourcedAgencyId String?
  isExpressTrack  Boolean   @default(false)
  aadhaarNumber   String?
  panNumber       String?
  isContractual   Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  mrf                MRF?                @relation(fields: [mrfId], references: [id])
  addedBy            User                @relation("CandidateAdder", fields: [addedById], references: [id])
  location           Location?           @relation(fields: [locationId], references: [id])
  sourcedAgency      Agency?             @relation("AgencySourcings", fields: [sourcedAgencyId], references: [id])
  documents          CandidateDocument[]
  comments           CandidateComment[]
  interviews         Interview[]
  assessments        Assessment[]
  trainingEnrollment TrainingEnrollment?
  examAttempts       ExamAttempt[]
  offerLetter        OfferLetter?
  appointmentLetter  AppointmentLetter?
  probation          Probation?
  aiScreeningResult  AIScreeningResult?
  agencySubmissions  AgencySubmission[]
  communications     Communication[]
  pipelineEntries    PipelineEntry[]
  casualWorker       CasualWorker?
  candidateSources   CandidateSource[]
}

model CandidateDocument {
  id          String    @id @default(cuid())
  candidateId String
  docType     String
  fileName    String
  filePath    String
  fileSize    Int?
  mimeType    String?
  verified    Boolean   @default(false)
  uploadedAt  DateTime  @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id])
}

model CandidateComment {
  id            String    @id @default(cuid())
  candidateId   String
  comment       String
  commentedById String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  candidate   Candidate @relation(fields: [candidateId], references: [id])
  commentedBy User      @relation(fields: [commentedById], references: [id])
}

model Interview {
  id            String    @id @default(cuid())
  candidateId   String
  round         Int       @default(1)
  interviewType String    @default("TECHNICAL")
  scheduledAt   DateTime
  duration      Int?
  mode          String    @default("ONLINE")
  location      String?
  meetingLink   String?
  status        String    @default("SCHEDULED")
  scheduledById String
  panelIds      String    @default("[]")
  notes         String?
  cancelReason  String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  candidate   Candidate           @relation(fields: [candidateId], references: [id])
  scheduledBy User                @relation("InterviewScheduler", fields: [scheduledById], references: [id])
  feedback    InterviewFeedback[]
}

model InterviewFeedback {
  id                  String    @id @default(cuid())
  interviewId         String
  interviewerId       String
  technicalScore      Int?
  communicationScore  Int?
  problemSolvingScore Int?
  cultureFitScore     Int?
  overallScore        Float?
  recommendation      String?
  strengths           String?
  weaknesses          String?
  comments            String?
  createdAt           DateTime  @default(now())

  interview   Interview @relation(fields: [interviewId], references: [id])
  interviewer User      @relation(fields: [interviewerId], references: [id])
}

model Assessment {
  id             String    @id @default(cuid())
  candidateId    String
  assessmentType String
  testName       String
  maxScore       Int
  obtainedScore  Int?
  passingScore   Int
  status         String    @default("PENDING")
  link           String?
  completedAt    DateTime?
  remarks        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id])
}

model TrainingBatch {
  id          String    @id @default(cuid())
  batchName   String
  batchCode   String    @unique
  designation String
  startDate   DateTime
  endDate     DateTime
  maxCapacity Int
  trainer     String?
  location    String?
  status      String    @default("UPCOMING")
  managedById String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  managedBy   User                 @relation("BatchManager", fields: [managedById], references: [id])
  enrollments TrainingEnrollment[]
  attendance  TrainingAttendance[]
}

model TrainingEnrollment {
  id             String    @id @default(cuid())
  candidateId    String    @unique
  batchId        String
  enrolledAt     DateTime  @default(now())
  status         String    @default("ENROLLED")
  completionDate DateTime?
  remarks        String?
  completedBy    String?

  candidate Candidate     @relation(fields: [candidateId], references: [id])
  batch     TrainingBatch @relation(fields: [batchId], references: [id])
}

model TrainingAttendance {
  id          String    @id @default(cuid())
  batchId     String
  candidateId String
  date        DateTime
  present     Boolean   @default(false)
  remarks     String?
  markedBy    String?
  markedAt    DateTime  @default(now())

  batch TrainingBatch @relation(fields: [batchId], references: [id])

  @@unique([batchId, candidateId, date])
}

model ExamAttempt {
  id            String    @id @default(cuid())
  candidateId   String
  examName      String
  examLink      String?
  linkToken     String    @unique @default(cuid())
  linkExpiresAt DateTime?
  attemptNumber Int       @default(1)
  status        String    @default("PENDING")
  score         Float?
  passingScore  Float?
  maxScore      Float?
  sentAt        DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  result        String?
  remarks       String?
  generatedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id])
}

model OfferLetter {
  id              String    @id @default(cuid())
  candidateId     String    @unique
  offerNumber     String    @unique
  designation     String
  department      String
  joiningDate     DateTime?
  expiryDate      DateTime
  basicSalary     Float
  hra             Float?
  allowances      String    @default("[]")
  deductions      String    @default("[]")
  grossSalary     Float
  netSalary       Float
  ctc             Float
  status          String    @default("DRAFT")
  pdfPath         String?
  approvedById    String?
  approvedAt      DateTime?
  sentAt          DateTime?
  respondedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id])
}

model AppointmentLetter {
  id                String    @id @default(cuid())
  candidateId       String    @unique
  appointmentNumber String    @unique
  designation       String
  department        String
  joiningDate       DateTime
  probationPeriod   Int       @default(180)
  pdfPath           String?
  generatedAt       DateTime  @default(now())
  sentAt            DateTime?

  candidate Candidate @relation(fields: [candidateId], references: [id])
}

model Probation {
  id                     String    @id @default(cuid())
  candidateId            String    @unique
  startDate              DateTime
  endDate                DateTime
  extendedEndDate        DateTime?
  status                 String    @default("ONGOING")
  reviewDate             DateTime?
  branchManagerApproval  String?
  countryManagerApproval String?
  mdApproval             String?
  remarks                String?
  extensionReason        String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String    @default("INFO")
  read      Boolean   @default(false)
  link      String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String    @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  oldValue  String?
  newValue  String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── Agency Management ────────────────────────────────────────────────────────

model Agency {
  id               String    @id @default(cuid())
  agencyCode       String    @unique
  name             String
  agencyType       String    @default("HIRING")
  contactPerson    String
  email            String
  phone            String
  address          String?
  city             String?
  state            String?
  country          String    @default("India")
  specializations  String    @default("[]")
  tier             String    @default("STANDARD")
  status           String    @default("ACTIVE")
  rating           Float?
  totalSubmissions Int       @default(0)
  successfulHires  Int       @default(0)
  contractStart    DateTime?
  contractEnd      DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  contacts          AgencyContact[]
  submissions       AgencySubmission[]
  partners          AgencyPartner[]
  locations         AgencyLocation[]
  sourcedCandidates Candidate[]    @relation("AgencySourcings")
  outreachSent      MrfOutreach[]
  incomingMails     IncomingMail[] @relation("AgencyIncomingMails")
}

model AgencyContact {
  id          String   @id @default(cuid())
  agencyId    String
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id])
}

model AgencySubmission {
  id          String    @id @default(cuid())
  agencyId    String
  mrfId       String
  candidateId String
  submittedAt DateTime  @default(now())
  status      String    @default("SUBMITTED")
  fee         Float?
  notes       String?
  updatedAt   DateTime  @updatedAt

  agency    Agency    @relation(fields: [agencyId], references: [id])
  mrf       MRF       @relation(fields: [mrfId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])
}

model AgencyPartner {
  id        String   @id @default(cuid())
  userId    String   @unique
  agencyId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  agency Agency @relation(fields: [agencyId], references: [id])
}

// ─── MRF Outreach ─────────────────────────────────────────────────────────────

model MrfOutreach {
  id            String   @id @default(cuid())
  mrfId         String
  agencyId      String
  sentById      String
  subject       String
  body          String
  status        String   @default("SENT")
  responseCount Int      @default(0)
  sentAt        DateTime @default(now())

  mrf     MRF          @relation(fields: [mrfId], references: [id])
  agency  Agency       @relation(fields: [agencyId], references: [id])
  sentBy  User         @relation(fields: [sentById], references: [id])
  replies IncomingMail[]
}

// ─── Job Postings (Platform Sourcing) ────────────────────────────────────────

model JobPosting {
  id           String    @id @default(cuid())
  mrfId        String
  platform     String
  title        String
  description  String
  status       String    @default("ACTIVE")
  postedAt     DateTime  @default(now())
  expiresAt    DateTime?
  postUrl      String?
  applications Int       @default(0)
  postedById   String
  notes        String?

  mrf      MRF  @relation(fields: [mrfId], references: [id])
  postedBy User @relation(fields: [postedById], references: [id])
}

// ─── Geographic Intelligence ──────────────────────────────────────────────────

model Location {
  id        String   @id @default(cuid())
  city      String
  state     String
  country   String   @default("India")
  region    String?
  zone      String?
  pincode   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  candidates Candidate[]
  agencies   AgencyLocation[]

  @@unique([city, state, country])
}

model AgencyLocation {
  id         String   @id @default(cuid())
  agencyId   String
  locationId String
  isPrimary  Boolean  @default(false)

  agency   Agency   @relation(fields: [agencyId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([agencyId, locationId])
}

// ─── Candidate Sourcing ───────────────────────────────────────────────────────

model CandidateSource {
  id          String    @id @default(cuid())
  candidateId String
  source      String
  platform    String?
  url         String?
  postedAt    DateTime?
  importedAt  DateTime  @default(now())
  rawData     String?

  candidate Candidate @relation(fields: [candidateId], references: [id])
}

// ─── AI Screening ─────────────────────────────────────────────────────────────

model JobDescription {
  id           String    @id @default(cuid())
  mrfId        String    @unique
  title        String
  description  String
  requirements String
  skills       String    @default("[]")
  experience   String?
  processedAt  DateTime?
  vectorData   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  mrf              MRF                @relation(fields: [mrfId], references: [id])
  screeningResults AIScreeningResult[]
}

model AIScreeningResult {
  id             String    @id @default(cuid())
  candidateId    String    @unique
  jdId           String
  matchScore     Float
  skillsMatched  String    @default("[]")
  skillsMissing  String    @default("[]")
  experienceGap  Int?
  recommendation String?
  summary        String?
  processedAt    DateTime  @default(now())
  modelVersion   String?

  candidate      Candidate      @relation(fields: [candidateId], references: [id])
  jobDescription JobDescription @relation(fields: [jdId], references: [id])
}

// ─── Email & Communication Engine ────────────────────────────────────────────

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  subject     String
  body        String
  category    String
  variables   String   @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  communications Communication[]
}

model Communication {
  id             String    @id @default(cuid())
  candidateId    String?
  templateId     String?
  sentById       String
  subject        String
  body           String
  channel        String    @default("EMAIL")
  status         String    @default("SENT")
  recipientEmail String?
  recipientPhone String?
  sentAt         DateTime  @default(now())
  failureReason  String?
  metadata       String?

  candidate Candidate?     @relation(fields: [candidateId], references: [id])
  template  EmailTemplate? @relation(fields: [templateId], references: [id])
  sentBy    User           @relation("CommSender", fields: [sentById], references: [id])
}

// ─── Recruitment Pipeline ─────────────────────────────────────────────────────

model PipelineStage {
  id        String   @id @default(cuid())
  mrfId     String
  name      String
  order     Int
  color     String   @default("#6366f1")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  mrf     MRF             @relation(fields: [mrfId], references: [id])
  entries PipelineEntry[]

  @@unique([mrfId, order])
}

model PipelineEntry {
  id          String   @id @default(cuid())
  candidateId String
  stageId     String
  enteredAt   DateTime @default(now())
  notes       String?

  candidate Candidate     @relation(fields: [candidateId], references: [id])
  stage     PipelineStage @relation(fields: [stageId], references: [id])
}

// ─── Incoming Mail ────────────────────────────────────────────────────────────

model IncomingMail {
  id            String    @id @default(cuid())
  messageId     String?   @unique
  fromEmail     String
  fromName      String?
  subject       String
  body          String?
  receivedAt    DateTime  @default(now())
  status        String    @default("UNPROCESSED")
  hasAttachment Boolean   @default(false)
  attachments   String    @default("[]")
  candidateId   String?
  agencyId      String?
  mrfId         String?
  outreachId    String?
  processedById String?
  processedAt   DateTime?
  notes         String?

  processedBy User?        @relation("MailProcessor", fields: [processedById], references: [id])
  agency      Agency?      @relation("AgencyIncomingMails", fields: [agencyId], references: [id])
  mrf         MRF?         @relation("MRFIncomingMails", fields: [mrfId], references: [id])
  outreach    MrfOutreach? @relation(fields: [outreachId], references: [id])
}

// ─── Casual / Contractual Workers ────────────────────────────────────────────

model CasualWorker {
  id              String    @id @default(cuid())
  candidateId     String    @unique
  workerType      String    @default("CASUAL")
  contractStart   DateTime
  contractEnd     DateTime?
  dailyRate       Float?
  monthlyRate     Float?
  aadhaarVerified Boolean   @default(false)
  panVerified     Boolean   @default(false)
  bankAccount     String?
  ifscCode        String?
  department      String?
  reportingTo     String?
  siteLocation    String?
  status          String    @default("ACTIVE")
  addedById       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id])
  addedBy   User      @relation("CasualWorkerAdder", fields: [addedById], references: [id])
}
